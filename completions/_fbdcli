#compdef fbdcli
# zsh completion for fbdcli.
#
# Install: add this file's directory to your fpath and run compinit, e.g.
#   mkdir -p ~/.zfunc && cp completions/_fbdcli ~/.zfunc/
#   echo 'fpath=(~/.zfunc $fpath); autoload -Uz compinit && compinit' >> ~/.zshrc

_fbdcli() {
  local -a commands
  commands=(
    'list:List displays (one line per display, --json for JSON)'
    'info:Show full detail for a display'
    'brightness:Get or set brightness (0-100)'
    'contrast:Get or set contrast (DDC, 0-100)'
    'volume:Get or set speaker volume (DDC, 0-100)'
    'mute:Get or set mute state (DDC)'
    'input:Get current input source or switch (DDC)'
    'caps:Read and print DDC capabilities'
    'modes:List all modes for a display'
    'set-mode:Apply a matching mode (WxH[@hz])'
    'ddc-test:DDC diagnostics'
    'xdr:Get or set XDR brightness upscaling (nits or off)'
    'preset:List factory presets or activate one by index'
    'hdr:Show or set HDR framebuffer mode'
    'virtual:Virtual screens (list/create/destroy/reconnect/disconnect-all)'
    'rotate:Rotate a display (0, 90, 180, 270)'
    'filter:Apply a full-screen software filter (or off)'
    'disable:Disable a display (black screen)'
    'enable:Re-enable a disabled display'
    'layout:Save/restore/protect the display arrangement'
    'group:Display groups (create/delete/add/remove/mirror/unmirror)'
    'edid:Export/apply/restore EDID, auto-apply toggle'
    'profile:List/apply/restore color profiles'
    'underscan:Get or set underscan (TVs)'
    'protect:Config protection (config/save/restore)'
    'http:HTTP control API (on/off/status)'
    'auth-token:Print the local HTTP API token'
    'settings:Print a masked settings dump'
    'pip:Stream a display in a picture-in-picture window'
    'stream:Redirect a display onto another display (or stop)'
    'automation:Per-display event automation rules'
    'osd:Show a transient OSD HUD'
    'sysvolume:Get or set the Mac output volume (CoreAudio)'
    'nightshift:Get or set Night Shift strength'
    'truetone:Get or set True Tone'
    'dark-mode:Get or set system Dark Mode'
    'dpcd:Read a DisplayPort sink\x27s DPCD over AUX'
    'ambient-light:Get or set ambient-light auto-brightness'
    'tv:Control a TV/AVR over the network'
    'report:Detailed report of every display (for bug reports)'
    'config:BetterDisplay-parity settings (show/protect/favourite/lockdim/…)'
    'help:Show help'
  )

  _arguments -C \
    '--direct[force direct-controller execution (bypass the app API)]' \
    '1:command:->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe 'command' commands
      ;;
    args)
      case $words[2] in
        virtual)
          _fbdcli_virtual
          ;;
        edid)
          _fbdcli_edid
          ;;
        layout)
          _fbdcli_layout
          ;;
        group)
          _fbdcli_group
          ;;
        protect)
          _fbdcli_protect
          ;;
        http)
          _fbdcli_http
          ;;
        tv)
          _fbdcli_tv
          ;;
        config)
          _fbdcli_config
          ;;
        profile)
          _fbdcli_profile
          ;;
        pip)
          _fbdcli_pip
          ;;
        stream)
          _fbdcli_stream
          ;;
        automation)
          _fbdcli_automation
          ;;
        rotate)
          _fbdcli_rotate
          ;;
        filter)
          _fbdcli_filter
          ;;
        sysvolume)
          _arguments '--list[list output devices]' '--device[select an output device]:device id or name:' '1:volume (0-100):'
          ;;
        report)
          _message 'optional output file'
          ;;
        brightness|contrast|volume)
          _fbdcli_percent_command
          ;;
        xdr)
          _values 'xdr action' 'off' 'nits'
          ;;
        set-mode)
          _message 'mode spec (e.g. 1920x1080@60)'
          ;;
        preset)
          _message 'display id [preset index]'
          ;;
        *)
          _fbdcli_display_id
          ;;
      esac
      ;;
  esac
}

_fbdcli_virtual() {
  local -a sub
  sub=(
    'list:List persisted virtual screen configs'
    'create:Create and connect a virtual screen'
    'destroy:Disconnect and forget a virtual screen'
    'reconnect:Reconnect a persisted virtual screen'
    'disconnect-all:Disconnect all virtual screens (keep configs)'
  )
  _describe 'virtual subcommand' sub
}

_fbdcli_edid() {
  local -a sub
  sub=(
    'export:Export the display EDID (hex dump or file)'
    'apply:Apply an EDID override (file or hex)'
    'restore:Restore the factory EDID'
    'auto:Get or set auto-apply of saved EDID overrides'
  )
  _describe 'edid subcommand' sub
}

_fbdcli_layout() {
  local -a sub
  sub=(
    'save:Save the current display arrangement'
    'restore:Restore the saved arrangement'
    'protect:Get or set layout protection'
    'edge-crossing:Get or set pointer crossing between misaligned displays'
  )
  _describe 'layout subcommand' sub
}

_fbdcli_group() {
  local -a sub
  sub=(
    'list:List display groups'
    'create:Create a group'
    'delete:Delete a group'
    'add:Add a display to a group'
    'remove:Remove a display from a group'
    'mirror:Mirror a group'
    'unmirror:Unmirror a group'
  )
  _describe 'group subcommand' sub
}

_fbdcli_config() {
  local -a sub
  if (( CURRENT > 3 )); then
    case $words[3] in
      vscreen) _values 'vscreen subcommand' list associate disassociate apply ;;
      uiscale) _values 'uiscale action' on off show ;;
      device) _values 'device subcommand' list add remove attach detach attachments ;;
      keytarget) _values 'keytarget' mouse focused all audio ;;
      connections) _values 'connections action' connect-all disconnect-all-but-main swap-identical ;;
      favourite) _values 'favourite action' list save apply ;;
      lockdim) _values 'lockdim' on off ;;
    esac
    return
  fi
  sub=(
    'show:Show the configuration summary'
    'protect:Per-property configuration protection'
    'favourite:Resolution favourites (list/save/apply)'
    'preset:Display presets'
    'lockdim:Lock dimming (on/off)'
    'lockdim-target:Lock dimming target (0-100)'
    'keytarget:Keyboard control target (mouse/focused/all/audio)'
    'group-policy:Display-group sync policy'
    'group-enabled:Enable or disable a display group sync'
    'group-sync:Group sync value (0-100)'
    'connections:connect-all, disconnect-all-but-main, swap-identical'
    'model:Per-model setting'
    'device:Saved network devices (list/add/remove/attach/detach/attachments)'
    'identity:Display identity method'
    'transfer:Transfer settings between two displays'
    'vscreen:Virtual screen associations (list/associate/disassociate/apply)'
    'uiscale:UI scale matching (on/off/show)'
  )
  _describe 'config subcommand' sub
}

_fbdcli_profile() {
  local -a sub
  sub=(
    'list:List color profiles'
    'apply:Apply a color profile by index or URL'
    'restore:Restore the default color profile'
  )
  _describe 'profile subcommand' sub
}

_fbdcli_pip() {
  local -a sub
  sub=(
    'list:List capturable displays, windows and apps'
    'stop:Stop the active CLI PiP stream'
    '--window:Stream a single window (window id)'
    '--app:Stream every window of an app (bundle id)'
  )
  _describe 'pip subcommand' sub
}

_fbdcli_stream() {
  local -a sub
  sub=('stop:Stop the active CLI stream')
  _describe 'stream subcommand' sub
}

_fbdcli_automation() {
  local -a sub
  if (( CURRENT > 4 )) && [[ $words[3] == add ]]; then
    case $CURRENT in
      5) _values 'event' connect disconnect sleep wake manual ;;
      6) _values 'action' shell url notify ;;
    esac
    return
  fi
  sub=(
    'list:List automation rules'
    'add:Add a rule (<id|any> <event> <shell|url|notify> <payload>)'
    'enable:Enable a rule'
    'disable:Disable a rule'
    'remove:Remove a rule'
    'test:Run a rule now and show its output'
    'run:Run a rule now and show its output'
    'log:Show runs from this session'
  )
  _describe 'automation subcommand' sub
}

_fbdcli_rotate() {
  if (( CURRENT > 3 )); then
    _values 'rotation' 0 90 180 270
  else
    _fbdcli_display_id
  fi
}

_fbdcli_filter() {
  if (( CURRENT > 3 )); then
    _arguments '--invert[invert colours]' '--sharpness[sharpness]:amount:' '--radius[unsharp radius]:px:' \
      '--zoom[zoom factor]:factor:' '--pan[pan offset]:x y:' '--lut[3D LUT file]:file:_files -g "*.cube"' 'off[clear the filter]'
  else
    _fbdcli_display_id
  fi
}

_fbdcli_protect() {
  local -a sub
  sub=(
    'config:Get or set config protection'
    'save:Save current resolution/preset/brightness'
    'restore:Re-apply saved config'
  )
  _describe 'protect subcommand' sub
}

_fbdcli_http() {
  local -a sub
  sub=(
    'on:Enable the HTTP control API (optional port)'
    'off:Disable the HTTP control API'
    'status:Show HTTP API state and port'
  )
  _describe 'http subcommand' sub
}

_fbdcli_tv() {
  local -a brands
  brands=(lg samsung philips yamaha)
  _describe 'tv brand' brands
}

_fbdcli_percent_command() {
  if (( CURRENT > 3 )); then
    _values 'value' '0-100'
  else
    _fbdcli_display_id
  fi
}

_fbdcli_display_id() {
  _message 'display id'
}

_fbdcli "$@"
